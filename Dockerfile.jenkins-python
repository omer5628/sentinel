# Jenkins Python 3.11 agent using the available uv container.
ARG PYTHON_BASE_IMAGE=python:3.11
ARG UV_TOOL_IMAGE=ghcr.io/astral-sh/uv:python3.10-alpine

FROM ${UV_TOOL_IMAGE} AS uv-source

FROM ${PYTHON_BASE_IMAGE} AS runtime

COPY --from=uv-source /usr/local/bin/uv /usr/local/bin/uv
COPY --from=uv-source /usr/local/bin/uvx /usr/local/bin/uvx

# Prevent uv from downloading additional Python runtimes.
ENV UV_PYTHON_DOWNLOADS=never \
    UV_NO_PROGRESS=1 \
    PYTHONUNBUFFERED=1

RUN python -c 'import sys; assert sys.version_info[:2] == (3, 11)' \
    && uv --version \
    && uvx --version

WORKDIR /workspace
