ARG PYTHON_BASE_IMAGE=python:3.11
ARG UV_TOOL_IMAGE=ghcr.io/astral-sh/uv:python3.10-alpine

FROM ${UV_TOOL_IMAGE} AS uv-source

FROM ${PYTHON_BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_TOOL_BIN_DIR=/opt/uv-bin \
    UV_TOOL_DIR=/opt/uv-tools \
    PATH="/opt/uv-bin:/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/src"

WORKDIR /app

COPY --from=uv-source /usr/local/bin/uv /usr/local/bin/uvx /bin/

COPY pyproject.toml uv.lock ./

RUN uv sync \
    --locked \
    --no-dev \
    --no-install-project \
    --no-cache

RUN uv tool install \
    --python /usr/local/bin/python \
    --no-cache \
    "clearml-serving==1.3.5"

COPY src/ ./src/
COPY conf/ ./conf/

COPY scripts/register_serving_candidate.py \
     scripts/promote_serving_canary.py \
     scripts/render_serving_preprocess.py \
     ./scripts/

COPY serving/preprocess/ ./serving/preprocess/
COPY scripts/verify_serving_inference.py ./scripts/

COPY data/golden_set.csv ./data/golden_set.csv
COPY data/golden_set_manifest.json ./data/golden_set_manifest.json

# Training has one stage. Remove packages only after dependency installation.
RUN apt-get purge -y \
      libmariadb-dev \
      libmariadb-dev-compat \
      libopenexr-dev \
      libxml2-dev \
      linux-libc-dev \
      libmariadb3 \
      mariadb-common \
      libopenexr-3-1-30 \
      libxml2 \
      openssh-client \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

ENTRYPOINT ["python", "-m", "sentinel.train"]
