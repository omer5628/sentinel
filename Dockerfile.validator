ARG PYTHON_BASE_IMAGE=python:3.11
ARG UV_TOOL_IMAGE=ghcr.io/astral-sh/uv:python3.10-alpine

FROM ${UV_TOOL_IMAGE} AS uv-source

FROM ${PYTHON_BASE_IMAGE} AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

COPY --from=uv-source /usr/local/bin/uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./

RUN uv sync \
    --frozen \
    --only-group validation \
    --no-install-project \
    --no-editable

FROM ${PYTHON_BASE_IMAGE} AS runtime

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app/src" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN groupadd --system sentinel \
    && useradd \
        --system \
        --gid sentinel \
        --home-dir /app \
        --no-create-home \
        sentinel

# Remove Debian development packages and unneeded runtime packages
# from the final image after dependency installation occurs in builder.
# These removals were validated with the Validator smoke test and an
# offline Trivy scan. Recheck if runtime dependencies change.
RUN apt-get purge -y \
      libmariadb-dev \
      libmariadb-dev-compat \
      libopenexr-dev \
      libxml2-dev \
      linux-libc-dev \
      libmariadb3 \
      mariadb-common \
      libopenexr-3-1-30 \
      libxml2 \
      openssh-client \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

COPY --from=builder /opt/venv /opt/venv
COPY src/ ./src/

USER sentinel

CMD ["python", "-m", "sentinel.retraining.validate_data"]
