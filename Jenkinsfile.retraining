pipeline {
    agent {
        kubernetes {
            defaultContainer 'python'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins-deployer

  containers:
    - name: python
      image: ghcr.io/astral-sh/uv:python3.11-bookworm-slim
      command:
        - cat
      tty: true
      resources:
        requests:
          cpu: 250m
          memory: 256Mi
        limits:
          cpu: "1"
          memory: 1Gi

    - name: helm
      image: alpine/helm:3.18.6
      command:
        - sh
        - -c
      args:
        - sleep infinity
      resources:
        requests:
          cpu: 100m
          memory: 128Mi
        limits:
          cpu: 500m
          memory: 512Mi

    - name: kubectl
      image: alpine/k8s:1.35.8
      command:
        - sh
        - -c
      args:
        - sleep infinity
      resources:
        requests:
          cpu: 100m
          memory: 128Mi
        limits:
          cpu: 500m
          memory: 512Mi
'''
        }
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                [
                    key: 'alert_status',
                    value: '$.status',
                    expressionType: 'JSONPath',
                    regexpFilter: '',
                    defaultValue: ''
                ],
                [
                    key: 'alert_name',
                    value: '$.commonLabels.alertname',
                    expressionType: 'JSONPath',
                    regexpFilter: '',
                    defaultValue: ''
                ],
                [
                    key: 'alert_class',
                    value: '$.commonLabels.class_name',
                    expressionType: 'JSONPath',
                    regexpFilter: '',
                    defaultValue: ''
                ],
                [
                    key: 'alert_strategy',
                    value: '$.commonLabels.strategy',
                    expressionType: 'JSONPath',
                    regexpFilter: '',
                    defaultValue: ''
                ]
            ],

            causeString: 'AlertManager: $alert_name ($alert_status)',

            printContributedVariables: true,
            printPostContent: false,
            silentResponse: false,
            shouldNotFlatten: true,

            regexpFilterText: '$alert_status:$alert_name',
            regexpFilterExpression:
                '^firing:SentinelPredictionDistributionDrift$'
        )
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
    }

    stages {
        stage('Emergency Brake') {
            steps {
                script {
                    def retrainingEnabled = sh(
                        script: '''
                            python scripts/read_ops_flag.py \
                              RETRAINING_ENABLED \
                              sentinel-dev
                        ''',
                        returnStdout: true
                    ).trim()

                    echo(
                        "RETRAINING_ENABLED=${retrainingEnabled}"
                    )

                    if (retrainingEnabled != 'true') {
                        currentBuild.result = 'ABORTED'

                        error(
                            'Continuous retraining is disabled ' +
                            'by sentinel-ops-flags.'
                        )
                    }

                    echo(
                        'Emergency brake passed. ' +
                        'Continuous retraining is enabled.'
                    )
                }
            }
        }

        stage('Resolve Worker Artifact') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu

                        WORKER_IMAGE="$(
                            kubectl get deployment \
                              sentinel-worker \
                              --namespace sentinel-dev \
                              -o jsonpath='{.spec.template.spec.containers[0].image}'
                        )"

                        if [ -z "$WORKER_IMAGE" ]; then
                            echo "Unable to resolve the deployed worker image."
                            exit 1
                        fi

                        case "$WORKER_IMAGE" in
                            *@*)
                                echo "Digest-based worker images are not supported by this workflow yet."
                                exit 1
                                ;;
                            *:*)
                                ;;
                            *)
                                echo "Worker image does not contain an immutable tag."
                                exit 1
                                ;;
                        esac

                        WORKER_REPOSITORY="${WORKER_IMAGE%:*}"
                        WORKER_TAG="${WORKER_IMAGE##*:}"

                        case "$WORKER_TAG" in
                            ''|*[!0-9]*)
                                echo "Expected a Jenkins BUILD_NUMBER worker tag."
                                echo "Resolved image: $WORKER_IMAGE"
                                exit 1
                                ;;
                        esac

                        printf '%s\\n' \
                          "$WORKER_REPOSITORY" \
                          > .retraining-worker-repository

                        printf '%s\\n' \
                          "$WORKER_TAG" \
                          > .retraining-worker-tag

                        echo "Using deployed worker image: $WORKER_IMAGE"
                    '''
                }
            }
        }

        stage('Render Fetch Data Job') {
            steps {
                container('helm') {
                    sh '''
                        set -eu

                        WORKER_REPOSITORY="$(
                            cat .retraining-worker-repository
                        )"

                        WORKER_TAG="$(
                            cat .retraining-worker-tag
                        )"

                        helm template sentinel \
                          charts/sentinel \
                          --namespace sentinel-dev \
                          -f charts/sentinel/values-dev.yaml \
                          --set retraining.enabled=true \
                          --set-string retraining.runId="${BUILD_NUMBER}" \
                          --set-string worker.image.repository="${WORKER_REPOSITORY}" \
                          --set-string worker.image.tag="${WORKER_TAG}" \
                          --show-only templates/retraining-fetch-job.yaml \
                          > retraining-fetch-job.yaml

                        test -s retraining-fetch-job.yaml

                        grep -F \
                          "sentinel-retraining-fetch-${BUILD_NUMBER}" \
                          retraining-fetch-job.yaml \
                          > /dev/null

                        grep -F \
                          "${WORKER_REPOSITORY}:${WORKER_TAG}" \
                          retraining-fetch-job.yaml \
                          > /dev/null

                        echo "Retraining Fetch Data Job rendered successfully."
                    '''
                }
            }
        }

        stage('Fetch Data') {
            steps {
                script {
                    def fetchStatus

                    container('kubectl') {
                        fetchStatus = sh(
                            script: '''
                                set -u

                                JOB_NAME="sentinel-retraining-fetch-${BUILD_NUMBER}"

                                if ! kubectl create \
                                  --namespace sentinel-dev \
                                  -f retraining-fetch-job.yaml
                                then
                                    echo "Failed to create retraining Fetch Data Job."
                                    exit 1
                                fi

                                if ! kubectl wait \
                                  --namespace sentinel-dev \
                                  --for=condition=complete \
                                  "job/${JOB_NAME}" \
                                  --timeout=5m
                                then
                                    echo "Retraining Fetch Data Job did not complete successfully."

                                    kubectl describe \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      || true

                                    kubectl logs \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      --all-containers=true \
                                      > retraining-fetch.log \
                                      2>&1 \
                                      || true

                                    cat retraining-fetch.log || true

                                    exit 1
                                fi

                                kubectl logs \
                                  --namespace sentinel-dev \
                                  "job/${JOB_NAME}" \
                                  --all-containers=true \
                                  > retraining-fetch.log \
                                  2>&1

                                cat retraining-fetch.log
                            ''',
                            returnStatus: true
                        )
                    }

                    archiveArtifacts(
                        artifacts: 'retraining-fetch.log',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )

                    if (fetchStatus != 0) {
                        error(
                            'Retraining Fetch Data Job failed.'
                        )
                    }
                }
            }
        }

        stage('Evaluate Data Gate') {
            steps {
                sh '''
                    set -eu

                    GATE_STATUS="$(
                        sed -n \
                          's/^retraining_gate=//p' \
                          retraining-fetch.log \
                        | tail -n 1
                    )"

                    RETRAINING_CUTOFF="$(
                        sed -n \
                          's/^retraining_cutoff=//p' \
                          retraining-fetch.log \
                        | tail -n 1
                    )"

                    NEW_ROWS="$(
                        sed -n \
                          's/^new_rows=//p' \
                          retraining-fetch.log \
                        | tail -n 1
                    )"

                    MINIMUM_NEW_ROWS="$(
                        sed -n \
                          's/^minimum_new_rows=//p' \
                          retraining-fetch.log \
                        | tail -n 1
                    )"

                    case "$GATE_STATUS" in
                        passed|blocked)
                            ;;
                        *)
                            echo "Invalid or missing retraining gate status."
                            exit 1
                            ;;
                    esac

                    if [ -z "$RETRAINING_CUTOFF" ]; then
                        echo "Invalid or missing retraining cutoff."
                        exit 1
                    fi

                    case "$NEW_ROWS" in
                        ''|*[!0-9]*)
                            echo "Invalid or missing new_rows value."
                            exit 1
                            ;;
                    esac

                    case "$MINIMUM_NEW_ROWS" in
                        ''|*[!0-9]*)
                            echo "Invalid or missing minimum_new_rows value."
                            exit 1
                            ;;
                    esac

                    printf '%s\\n' \
                      "$GATE_STATUS" \
                      > .retraining-gate-status

                    printf '%s\\n' \
                      "$RETRAINING_CUTOFF" \
                      > .retraining-cutoff

                    printf '%s\\n' \
                      "$NEW_ROWS" \
                      > .retraining-new-rows

                    printf '%s\\n' \
                      "$MINIMUM_NEW_ROWS" \
                      > .retraining-minimum-new-rows
                '''

                script {
                    def gateStatus = sh(
                        script: 'cat .retraining-gate-status',
                        returnStdout: true
                    ).trim()

                    def newRows = sh(
                        script: 'cat .retraining-new-rows',
                        returnStdout: true
                    ).trim()

                    def minimumNewRows = sh(
                        script: 'cat .retraining-minimum-new-rows',
                        returnStdout: true
                    ).trim()

                    echo(
                        "Retraining data gate: " +
                        "${newRows}/${minimumNewRows} new rows."
                    )

                    if (gateStatus == 'blocked') {
                        currentBuild.result = 'ABORTED'

                        error(
                            'Retraining data gate blocked: ' +
                            "${newRows} new labeled rows are available, " +
                            "but ${minimumNewRows} are required."
                        )
                    }

                    if (gateStatus != 'passed') {
                        error(
                            "Unexpected retraining gate status: " +
                            gateStatus
                        )
                    }

                    echo(
                        'Retraining data gate passed.'
                    )
                }
            }
        }

        stage('Render Validation Job') {
            steps {
                container('helm') {
                    sh '''
                        set -eu

                        WORKER_TAG="$(
                            cat .retraining-worker-tag
                        )"

                        RETRAINING_CUTOFF="$(
                            cat .retraining-cutoff
                        )"

                        helm template sentinel \
                          charts/sentinel \
                          --namespace sentinel-dev \
                          -f charts/sentinel/values-dev.yaml \
                          --set retraining.enabled=true \
                          --set retraining.validation.enabled=true \
                          --set-string retraining.runId="${BUILD_NUMBER}" \
                          --set-string retraining.cutoff="${RETRAINING_CUTOFF}" \
                          --set-string retraining.validation.image.tag="${WORKER_TAG}" \
                          --show-only templates/retraining-validation-job.yaml \
                          > retraining-validation-job.yaml

                        test -s retraining-validation-job.yaml

                        grep -F \
                          "sentinel-retraining-validation-${BUILD_NUMBER}" \
                          retraining-validation-job.yaml \
                          > /dev/null

                        VALIDATOR_IMAGE="$(
                            sed -n \
                              's/^[[:space:]]*image: "\\(.*\\)"$/\\1/p' \
                              retraining-validation-job.yaml \
                            | head -n 1
                        )"

                        if [ -z "$VALIDATOR_IMAGE" ]; then
                            echo "Unable to resolve rendered validator image."
                            exit 1
                        fi

                        case "$VALIDATOR_IMAGE" in
                            *:"${WORKER_TAG}")
                                ;;
                            *)
                                echo "Validator image tag does not match deployed worker tag."
                                echo "Rendered validator image: $VALIDATOR_IMAGE"
                                echo "Expected immutable tag: $WORKER_TAG"
                                exit 1
                                ;;
                        esac

                        echo "Using validator image: $VALIDATOR_IMAGE"
                        echo "Retraining Validation Job rendered successfully."
                    '''
                }
            }
        }

        stage('Validate Training Data') {
            steps {
                script {
                    def validationStatus

                    container('kubectl') {
                        validationStatus = sh(
                            script: '''
                                set -u

                                JOB_NAME="sentinel-retraining-validation-${BUILD_NUMBER}"

                                if ! kubectl create \
                                  --namespace sentinel-dev \
                                  -f retraining-validation-job.yaml
                                then
                                    echo "Failed to create retraining Validation Job."
                                    exit 1
                                fi

                                if ! kubectl wait \
                                  --namespace sentinel-dev \
                                  --for=condition=complete \
                                  "job/${JOB_NAME}" \
                                  --timeout=5m
                                then
                                    echo "Retraining Validation Job did not complete successfully."

                                    kubectl describe \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      || true

                                    kubectl logs \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      --all-containers=true \
                                      > retraining-validation.log \
                                      2>&1 \
                                      || true

                                    cat retraining-validation.log || true

                                    exit 1
                                fi

                                kubectl logs \
                                  --namespace sentinel-dev \
                                  "job/${JOB_NAME}" \
                                  --all-containers=true \
                                  > retraining-validation.log \
                                  2>&1

                                cat retraining-validation.log

                                VALIDATION_STATUS="$(
                                    sed -n \
                                      's/^validation_status=//p' \
                                      retraining-validation.log \
                                    | tail -n 1
                                )"

                                if [ "$VALIDATION_STATUS" != "passed" ]; then
                                    echo "Training data validation did not report a passing status."
                                    echo "validation_status=${VALIDATION_STATUS}"
                                    exit 1
                                fi
                            ''',
                            returnStatus: true
                        )
                    }

                    archiveArtifacts(
                        artifacts: 'retraining-validation.log',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )

                    if (validationStatus != 0) {
                        error(
                            'Retraining training-data validation failed.'
                        )
                    }

                    echo(
                        'Retraining training-data validation passed.'
                    )
                }
            }
        }

        stage('Render Train Job') {
            steps {
                container('helm') {
                    sh '''
                        set -eu

                        WORKER_TAG="$(
                            cat .retraining-worker-tag
                        )"

                        RETRAINING_CUTOFF="$(
                            cat .retraining-cutoff
                        )"

                        helm template sentinel \
                          charts/sentinel \
                          --namespace sentinel-dev \
                          -f charts/sentinel/values-dev.yaml \
                          --set retraining.enabled=true \
                          --set retraining.train.enabled=true \
                          --set-string retraining.runId="${BUILD_NUMBER}" \
                          --set-string retraining.cutoff="${RETRAINING_CUTOFF}" \
                          --set-string retraining.train.image.tag="${WORKER_TAG}" \
                          --show-only templates/retraining-train-job.yaml \
                          > retraining-train-job.yaml

                        test -s retraining-train-job.yaml

                        grep -F \
                          "sentinel-retraining-train-${BUILD_NUMBER}" \
                          retraining-train-job.yaml \
                          > /dev/null

                        TRAIN_IMAGE="$(
                            sed -n \
                              's/^[[:space:]]*image: "\\(.*\\)"$/\\1/p' \
                              retraining-train-job.yaml \
                            | head -n 1
                        )"

                        if [ -z "$TRAIN_IMAGE" ]; then
                            echo "Unable to resolve rendered training image."
                            exit 1
                        fi

                        case "$TRAIN_IMAGE" in
                            *:"${WORKER_TAG}")
                                ;;
                            *)
                                echo "Training image tag does not match deployed worker tag."
                                echo "Rendered training image: $TRAIN_IMAGE"
                                echo "Expected immutable tag: $WORKER_TAG"
                                exit 1
                                ;;
                        esac

                        echo "Using retraining image: $TRAIN_IMAGE"
                        echo "Retraining Train Job rendered successfully."
                    '''
                }
            }
        }

        stage('Train') {
            steps {
                script {
                    def trainStatus

                    container('kubectl') {
                        trainStatus = sh(
                            script: '''
                                set -u

                                JOB_NAME="sentinel-retraining-train-${BUILD_NUMBER}"

                                if ! kubectl create \
                                  --namespace sentinel-dev \
                                  -f retraining-train-job.yaml
                                then
                                    echo "Failed to create retraining Train Job."
                                    exit 1
                                fi

                                if ! kubectl wait \
                                  --namespace sentinel-dev \
                                  --for=condition=complete \
                                  "job/${JOB_NAME}" \
                                  --timeout=30m
                                then
                                    echo "Retraining Train Job did not complete successfully."

                                    kubectl describe \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      || true

                                    kubectl logs \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      --all-containers=true \
                                      > retraining-train.log \
                                      2>&1 \
                                      || true

                                    cat retraining-train.log || true

                                    exit 1
                                fi

                                kubectl logs \
                                  --namespace sentinel-dev \
                                  "job/${JOB_NAME}" \
                                  --all-containers=true \
                                  > retraining-train.log \
                                  2>&1

                                cat retraining-train.log
                            ''',
                            returnStatus: true
                        )
                    }

                    archiveArtifacts(
                        artifacts: 'retraining-train.log',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )

                    if (trainStatus != 0) {
                        error(
                            'Retraining Train Job failed.'
                        )
                    }

                    echo(
                        'Retraining completed successfully. ' +
                        'Checkpoint update will run next.'
                    )
                }
            }
        }

        stage('Render Checkpoint Job') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu

                        test -s .retraining-worker-tag
                        test -s .retraining-cutoff

                        WORKER_TAG="$(
                            cat .retraining-worker-tag
                        )"

                        RETRAINING_CUTOFF="$(
                            cat .retraining-cutoff
                        )"

                        case "$WORKER_TAG" in
                            ''|*[!0-9]*)
                                echo "Invalid retraining worker tag: $WORKER_TAG"
                                exit 1
                                ;;
                        esac

                        if [ -z "$RETRAINING_CUTOFF" ]; then
                            echo "Retraining cutoff is missing."
                            exit 1
                        fi

                        helm template sentinel \
                          charts/sentinel \
                          --namespace sentinel-dev \
                          -f charts/sentinel/values-dev.yaml \
                          --set retraining.enabled=true \
                          --set retraining.checkpoint.enabled=true \
                          --set retraining.validation.enabled=false \
                          --set-string retraining.runId="${BUILD_NUMBER}" \
                          --set-string retraining.cutoff="${RETRAINING_CUTOFF}" \
                          --set-string worker.image.tag="${WORKER_TAG}" \
                          --show-only templates/retraining-checkpoint-job.yaml \
                          > retraining-checkpoint-job.yaml

                        test -s retraining-checkpoint-job.yaml

                        grep -F \
                          "sentinel-retraining-checkpoint-${BUILD_NUMBER}" \
                          retraining-checkpoint-job.yaml \
                          > /dev/null

                        CHECKPOINT_IMAGE="$(
                            sed -n \
                              's/^[[:space:]]*image: "\\(.*\\)"$/\\1/p' \
                              retraining-checkpoint-job.yaml \
                            | head -n 1
                        )"

                        if [ -z "$CHECKPOINT_IMAGE" ]; then
                            echo "Unable to resolve rendered checkpoint image."
                            exit 1
                        fi

                        case "$CHECKPOINT_IMAGE" in
                            *:"${WORKER_TAG}")
                                ;;
                            *)
                                echo "Checkpoint image tag does not match deployed worker tag."
                                echo "Rendered checkpoint image: $CHECKPOINT_IMAGE"
                                echo "Expected immutable tag: $WORKER_TAG"
                                exit 1
                                ;;
                        esac

                        grep -F \
                          "value: \\"${RETRAINING_CUTOFF}\\"" \
                          retraining-checkpoint-job.yaml \
                          > /dev/null

                        echo "Using checkpoint image: $CHECKPOINT_IMAGE"
                        echo "Checkpoint Job rendered successfully."
                    '''
                }
            }
        }

        stage('Update Checkpoint') {
            steps {
                script {
                    def checkpointStatus

                    container('kubectl') {
                        checkpointStatus = sh(
                            script: '''
                                set -u

                                JOB_NAME="sentinel-retraining-checkpoint-${BUILD_NUMBER}"

                                if ! kubectl create \
                                  --namespace sentinel-dev \
                                  -f retraining-checkpoint-job.yaml
                                then
                                    echo "Failed to create retraining Checkpoint Job."
                                    exit 1
                                fi

                                if ! kubectl wait \
                                  --namespace sentinel-dev \
                                  --for=condition=complete \
                                  "job/${JOB_NAME}" \
                                  --timeout=2m
                                then
                                    echo "Retraining Checkpoint Job did not complete successfully."

                                    kubectl describe \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      || true

                                    kubectl logs \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      --all-containers=true \
                                      > retraining-checkpoint.log \
                                      2>&1 \
                                      || true

                                    cat retraining-checkpoint.log || true

                                    exit 1
                                fi

                                kubectl logs \
                                  --namespace sentinel-dev \
                                  "job/${JOB_NAME}" \
                                  --all-containers=true \
                                  > retraining-checkpoint.log \
                                  2>&1

                                cat retraining-checkpoint.log

                                CHECKPOINT_STATUS="$(
                                    sed -n \
                                      's/^checkpoint_status=//p' \
                                      retraining-checkpoint.log \
                                    | tail -n 1
                                )"

                                case "$CHECKPOINT_STATUS" in
                                    advanced|unchanged)
                                        ;;
                                    *)
                                        echo "Invalid checkpoint status: $CHECKPOINT_STATUS"
                                        exit 1
                                        ;;
                                esac

                                EXPECTED_CUTOFF="$(
                                    cat .retraining-cutoff
                                )"

                                ACTUAL_CUTOFF="$(
                                    sed -n \
                                      's/^last_successful_cutoff=//p' \
                                      retraining-checkpoint.log \
                                    | tail -n 1
                                )"

                                if [ "$ACTUAL_CUTOFF" != "$EXPECTED_CUTOFF" ]; then
                                    echo "Stored checkpoint does not match retraining cutoff."
                                    echo "Expected: $EXPECTED_CUTOFF"
                                    echo "Actual:   $ACTUAL_CUTOFF"
                                    exit 1
                                fi

                                echo "Retraining checkpoint verified successfully."
                            ''',
                            returnStatus: true
                        )
                    }

                    archiveArtifacts(
                        artifacts: 'retraining-checkpoint.log',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )

                    if (checkpointStatus != 0) {
                        error(
                            'Retraining Checkpoint Job failed.'
                        )
                    }

                    echo(
                        'Retraining pipeline completed successfully ' +
                        'and the successful cutoff was persisted.'
                    )
                }
            }
        }
    }

    post {
        always {
            container('kubectl') {
                sh '''
                    kubectl delete job \
                      "sentinel-retraining-fetch-${BUILD_NUMBER}" \
                      --namespace sentinel-dev \
                      --ignore-not-found=true \
                      --wait=false \
                      || true

                    kubectl delete job \
                      "sentinel-retraining-validation-${BUILD_NUMBER}" \
                      --namespace sentinel-dev \
                      --ignore-not-found=true \
                      --wait=false \
                      || true

                    kubectl delete job \
                      "sentinel-retraining-train-${BUILD_NUMBER}" \
                      --namespace sentinel-dev \
                      --ignore-not-found=true \
                      --wait=false \
                      || true

                    kubectl delete job \
                      "sentinel-retraining-checkpoint-${BUILD_NUMBER}" \
                      --namespace sentinel-dev \
                      --ignore-not-found=true \
                      --wait=false \
                      || true
                '''
            }

            sh '''
                rm -f retraining-fetch-job.yaml
                rm -f retraining-fetch.log
                rm -f retraining-validation-job.yaml
                rm -f retraining-validation.log
                rm -f retraining-train-job.yaml
                rm -f retraining-train.log
                rm -f retraining-checkpoint-job.yaml
                rm -f retraining-checkpoint.log
                rm -f .retraining-worker-repository
                rm -f .retraining-worker-tag
                rm -f .retraining-gate-status
                rm -f .retraining-cutoff
                rm -f .retraining-new-rows
                rm -f .retraining-minimum-new-rows
            '''
        }
    }
}
