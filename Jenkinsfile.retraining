pipeline {
    agent {
        kubernetes {
            defaultContainer 'python'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins-deployer

  containers:
    - name: python
      image: ghcr.io/astral-sh/uv:python3.11-bookworm-slim
      command:
        - cat
      tty: true
      resources:
        requests:
          cpu: 250m
          memory: 256Mi
        limits:
          cpu: "1"
          memory: 1Gi

    - name: git
      image: alpine/git:2.47.2
      command:
        - sh
        - -c
      args:
        - sleep infinity
      resources:
        requests:
          cpu: 100m
          memory: 128Mi
        limits:
          cpu: 500m
          memory: 512Mi

    - name: helm
      image: alpine/helm:3.18.6
      command:
        - sh
        - -c
      args:
        - sleep infinity
      resources:
        requests:
          cpu: 100m
          memory: 128Mi
        limits:
          cpu: 500m
          memory: 512Mi

    - name: kubectl
      image: alpine/k8s:1.35.8
      command:
        - sh
        - -c
      args:
        - sleep infinity
      resources:
        requests:
          cpu: 100m
          memory: 128Mi
        limits:
          cpu: 500m
          memory: 512Mi
'''
        }
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                [
                    key: 'alert_status',
                    value: '$.status',
                    expressionType: 'JSONPath',
                    regexpFilter: '',
                    defaultValue: ''
                ],
                [
                    key: 'alert_name',
                    value: '$.commonLabels.alertname',
                    expressionType: 'JSONPath',
                    regexpFilter: '',
                    defaultValue: ''
                ],
                [
                    key: 'alert_class',
                    value: '$.commonLabels.class_name',
                    expressionType: 'JSONPath',
                    regexpFilter: '',
                    defaultValue: ''
                ],
                [
                    key: 'alert_strategy',
                    value: '$.commonLabels.strategy',
                    expressionType: 'JSONPath',
                    regexpFilter: '',
                    defaultValue: ''
                ]
            ],

            causeString: 'AlertManager: $alert_name ($alert_status)',

            printContributedVariables: true,
            printPostContent: false,
            silentResponse: false,
            shouldNotFlatten: true,

            regexpFilterText: '$alert_status:$alert_name',
            regexpFilterExpression:
                '^firing:SentinelPredictionDistributionDrift$'
        )
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 75, unit: 'MINUTES')
    }

    parameters {
        booleanParam(
            name: 'GIT_PREFLIGHT_ONLY',
            defaultValue: false,
            description: 'Verify GitHub push credentials without training or modifying Canary.'
        )
        booleanParam(
            name: 'E2E_FETCH_ONLY',
            defaultValue: false,
            description: 'Run Fetch Data and its Data Gate only against isolated sentinel_e2e. Stop before training, Canary, Git, or checkpoint.'
        )
        booleanParam(
            name: 'E2E_SEED_DATA',
            defaultValue: false,
            description: 'Seed 1000 synthetic gate-only records in sentinel_e2e before E2E_FETCH_ONLY. Never enable for training.'
        )
    }

    stages {
        stage('E2E Seed Parameter Guard') {
            steps {
                script {
                    if (params.E2E_SEED_DATA == true &&
                        (params.E2E_FETCH_ONLY != true || params.GIT_PREFLIGHT_ONLY == true)) {
                        error('E2E_SEED_DATA requires E2E_FETCH_ONLY=true and GIT_PREFLIGHT_ONLY=false.')
                    }
                }
            }
        }

        stage('Git Credentials Preflight Only') {
            when {
                expression { params.GIT_PREFLIGHT_ONLY == true }
            }
            steps {
                container('git') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'github-push-credentials',
                            usernameVariable: 'GIT_PUSH_USERNAME',
                            passwordVariable: 'GIT_PUSH_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set +x
                            set -eu

                            git config --global --add safe.directory "$PWD"
                            REMOTE_URL="$(git remote get-url origin)"
                            case "$REMOTE_URL" in
                                https://github.com/*) ;;
                                *) echo 'Unexpected Git remote; refusing preflight.'; exit 1 ;;
                            esac

                            case "${GIT_BRANCH:-}" in
                                origin/*) TARGET_BRANCH="${GIT_BRANCH#origin/}" ;;
                                refs/remotes/origin/*)
                                    TARGET_BRANCH="${GIT_BRANCH#refs/remotes/origin/}" ;;
                                *) echo 'Unexpected Git checkout branch.'; exit 1 ;;
                            esac
                            git check-ref-format --branch "$TARGET_BRANCH" >/dev/null
                            LOCAL_SHA="$(git rev-parse HEAD)"
                            REMOTE_SHA="$(
                                git ls-remote --exit-code origin \
                                  "refs/heads/$TARGET_BRANCH" | awk '{print $1}'
                            )"
                            if [ "$LOCAL_SHA" != "$REMOTE_SHA" ]; then
                                echo 'Checkout differs from remote; refusing preflight.'
                                exit 1
                            fi

                            ASKPASS_FILE="$(mktemp)"
                            trap 'rm -f "$ASKPASS_FILE"' EXIT HUP INT TERM
                            cat > "$ASKPASS_FILE" <<'ASKPASS'
#!/bin/sh
case "$1" in
    *sername*) printf '%s\n' "$GIT_PUSH_USERNAME" ;;
    *assword*) printf '%s\n' "$GIT_PUSH_PASSWORD" ;;
    *) exit 1 ;;
esac
ASKPASS
                            chmod 700 "$ASKPASS_FILE"
                            export GIT_TERMINAL_PROMPT=0
                            export GIT_ASKPASS="$ASKPASS_FILE"

                            # Dry-run a new temporary branch ref to exercise write permissions.
                            # The remote repository is not changed by --dry-run.
                            git -c credential.helper= push --dry-run origin \
                              "HEAD:refs/heads/sentinel-preflight-${BUILD_NUMBER}"
                            echo 'Git credentials preflight passed (dry-run only).'
                        '''
                    }
                }
                script {
                    currentBuild.result = 'ABORTED'
                    error(
                        'Git credentials preflight finished. ' +
                        'No training or Canary promotion was started.'
                    )
                }
            }
        }

        stage('E2E Fetch Preflight') {
            when {
                expression { params.E2E_FETCH_ONLY == true }
            }
            steps {
                container('python') {
                    sh '''
                        set -eu
                        uv run --frozen python - <<'PYCODE'
from pathlib import Path
import yaml

config = yaml.safe_load(Path('charts/sentinel/values-e2e.yaml').read_text())
retraining = config['retraining']
assert retraining['pipelineName'] == 'sentinel-retraining-e2e'
assert retraining['database'] == {
    'configMapName': 'sentinel-retraining-e2e-db',
    'credentialsSecretName': 'sentinel-retraining-e2e-db-credentials',
}, 'Unsafe E2E database configuration'
assert retraining['databaseBootstrap']['databaseName'] == 'sentinel_e2e'
assert retraining['canaryPromotion']['enabled'] is False
print('PASS: E2E Fetch configuration preflight')
PYCODE
                    '''
                }
                container('kubectl') {
                    sh '''
                        set -eu
                        NAMESPACE=sentinel-dev
                        E2E_DB="$(kubectl get configmap sentinel-retraining-e2e-db \
                          -n "$NAMESPACE" -o jsonpath='{.data.POSTGRES_DB}')"
                        test "$E2E_DB" = 'sentinel_e2e' || {
                            echo 'Refusing E2E: wrong database in ConfigMap.' >&2
                            exit 1
                        }
                        kubectl get secret sentinel-retraining-e2e-db-credentials \
                          -n "$NAMESPACE" -o name > /dev/null
                        echo 'PASS: Isolated E2E database configuration is present.'
                    '''
                }
            }
        }

        stage('Seed E2E Data Gate Fixtures') {
            when {
                expression { params.E2E_FETCH_ONLY == true && params.E2E_SEED_DATA == true }
            }
            steps {
                container('helm') {
                    sh '''
                        set -eu

                        helm template sentinel charts/sentinel \
                          --namespace sentinel-dev \
                          -f charts/sentinel/values-dev.yaml \
                          -f charts/sentinel/values-e2e.yaml \
                          --set retraining.e2eDataSeed.enabled=true \
                          --show-only templates/retraining-e2e-data-seed-job.yaml \
                          > retraining-e2e-data-seed-job.yaml

                        test -s retraining-e2e-data-seed-job.yaml
                        echo 'E2E data seed Job rendered.'
                    '''
                }
                container('python') {
                    sh '''
                        set -eu
                        uv run --frozen python - <<'PYCODE'
from pathlib import Path
import yaml

items = [
    doc for doc in yaml.safe_load_all(
        Path('retraining-e2e-data-seed-job.yaml').read_text()
    ) if doc is not None
]
assert len(items) == 1, 'Expected exactly one E2E Seed Job'
job = items[0]
assert job['kind'] == 'Job'
assert job['metadata']['name'] == 'sentinel-e2e-data-gate-seed'
pod = job['spec']['template']['spec']
assert pod['automountServiceAccountToken'] is False
assert pod['restartPolicy'] == 'Never'
assert len(pod['containers']) == 1
container = pod['containers'][0]
envs = {item['name']: item for item in container['env']}
assert set(envs) == {
    'K8S_NAMESPACE', 'POSTGRES_HOST', 'POSTGRES_PORT',
    'POSTGRES_DB', 'POSTGRES_USER', 'POSTGRES_PASSWORD'
}
for key in ('POSTGRES_HOST', 'POSTGRES_PORT', 'POSTGRES_DB'):
    assert envs[key]['valueFrom']['configMapKeyRef'] == {
        'name': 'sentinel-retraining-e2e-db', 'key': key
    }, f'Unsafe database source: {key}'
for key in ('POSTGRES_USER', 'POSTGRES_PASSWORD'):
    assert envs[key]['valueFrom']['secretKeyRef'] == {
        'name': 'sentinel-retraining-e2e-db-credentials', 'key': key
    }, f'Unsafe credentials source: {key}'
assert envs['K8S_NAMESPACE']['valueFrom']['fieldRef']['fieldPath'] == 'metadata.namespace'
script = '\n'.join(container['args'])
for required in (
    'sentinel-dev', 'sentinel_e2e', 'sentinel_e2e_user',
    'current_database()', 'current_user',
    'generate_series(1, 1000)', 'E2E_FIXTURE',
):
    assert required in script, f'Missing E2E safety check: {required}'
print('PASS: E2E seed Job isolation validated')
PYCODE
                    '''
                }
                script {
                    def seedStatus
                    container('kubectl') {
                        seedStatus = sh(
                            script: '''
                                set -eu
                                NAMESPACE=sentinel-dev
                                JOB_NAME=sentinel-e2e-data-gate-seed

                                E2E_DB="$(kubectl get configmap sentinel-retraining-e2e-db \
                                  -n "$NAMESPACE" -o jsonpath='{.data.POSTGRES_DB}')"
                                test "$E2E_DB" = 'sentinel_e2e' || {
                                    echo 'Refusing seed: database is not sentinel_e2e.' >&2
                                    exit 1
                                }

                                E2E_USER="$(kubectl get secret sentinel-retraining-e2e-db-credentials \
                                  -n "$NAMESPACE" -o jsonpath='{.data.POSTGRES_USER}' | base64 -d)"
                                test "$E2E_USER" = 'sentinel_e2e_user' || {
                                    echo 'Refusing seed: unexpected database user.' >&2
                                    exit 1
                                }

                                # Jenkins is the only component authorized to create this test Job.
                                kubectl create -n "$NAMESPACE" -f retraining-e2e-data-seed-job.yaml
                                touch .e2e-seed-job-created

                                if ! kubectl wait -n "$NAMESPACE" \
                                  --for=condition=complete "job/${JOB_NAME}" --timeout=5m
                                then
                                    echo 'E2E seed Job failed or timed out.' >&2
                                    kubectl describe -n "$NAMESPACE" "job/${JOB_NAME}" || true
                                    kubectl logs -n "$NAMESPACE" "job/${JOB_NAME}" \
                                      --all-containers=true > retraining-e2e-data-seed.log 2>&1 || true
                                    cat retraining-e2e-data-seed.log || true
                                    exit 1
                                fi

                                kubectl logs -n "$NAMESPACE" "job/${JOB_NAME}" \
                                  --all-containers=true > retraining-e2e-data-seed.log 2>&1
                                cat retraining-e2e-data-seed.log
                                grep -F 'E2E data gate seed completed successfully.' \
                                  retraining-e2e-data-seed.log > /dev/null
                            ''',
                            returnStatus: true
                        )
                    }
                    archiveArtifacts(
                        artifacts: 'retraining-e2e-data-seed.log',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )
                    if (seedStatus != 0) {
                        error('Isolated E2E data seed failed. Fetch Data will not run.')
                    }
                    echo 'E2E seed complete. Continuing to fetch-only Data Gate test.'
                }
            }
        }

        stage('Emergency Brake') {
            steps {
                script {
                    if (params.E2E_FETCH_ONLY == true) {
                        echo 'Isolated E2E fetch-only mode: bypassing the live retraining brake.'
                        echo 'No retraining training, Canary promotion, Git update or checkpoint is permitted.'
                    } else {
                        def retrainingEnabled = sh(
                            script: '''
                                python scripts/read_ops_flag.py \
                                  RETRAINING_ENABLED \
                                  sentinel-dev
                            ''',
                            returnStdout: true
                        ).trim()

                        echo(
                            "RETRAINING_ENABLED=${retrainingEnabled}"
                        )

                        if (retrainingEnabled != 'true') {
                            currentBuild.result = 'ABORTED'

                            error(
                                'Continuous retraining is disabled ' +
                                'by sentinel-ops-flags.'
                            )
                        }

                        echo(
                            'Emergency brake passed. ' +
                            'Continuous retraining is enabled.'
                        )
                    }
                }
            }
        }

        stage('Resolve Current Model') {
            when {
                expression { params.E2E_FETCH_ONLY != true }
            }
            steps {
                container('python') {
                    sh '''
                        set -eu

                        CURRENT_MODEL_ID="$(
                            python - <<'PY'
from pathlib import Path

path = Path(
    "charts/sentinel/values-prod.yaml"
)

lines = path.read_text(
    encoding="utf-8"
).splitlines()

inside_model = False
references = []

for line in lines:
    if line == "model:":
        inside_model = True
        continue

    if (
        inside_model
        and line
        and not line[0].isspace()
    ):
        break

    if (
        inside_model
        and line.lstrip().startswith(
            "productionReference:"
        )
    ):
        value = line.split(
            ":",
            1,
        )[1].strip()

        value = value.strip(
            '"'
        ).strip(
            "'"
        )

        references.append(
            value
        )

if len(references) != 1:
    raise SystemExit(
        "Expected exactly one "
        "model.productionReference "
        "in values-prod.yaml."
    )

print(
    references[0]
)
PY
                        )"

                        if [ -z "$CURRENT_MODEL_ID" ]; then
                            echo "Current production model reference is empty."
                            exit 1
                        fi

                        case "$CURRENT_MODEL_ID" in
                            *[!0-9a-fA-F]*)
                                echo "Current model ID has an invalid format."
                                echo "Value: $CURRENT_MODEL_ID"
                                exit 1
                                ;;
                        esac

                        if [ "${#CURRENT_MODEL_ID}" -ne 32 ]; then
                            echo "Current model ID must contain 32 characters."
                            echo "Value: $CURRENT_MODEL_ID"
                            exit 1
                        fi

                        printf '%s\\n' \
                            "$CURRENT_MODEL_ID" \
                            > .current-model-id

                        echo "Current production model ID resolved successfully."
                        echo "Current model ID: $CURRENT_MODEL_ID"
                    '''
                }

                archiveArtifacts(
                    artifacts: '.current-model-id',
                    fingerprint: true
                )
            }
        }

        stage('Resolve Worker Artifact') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu

                        WORKER_IMAGE="$(
                            kubectl get deployment \
                              sentinel-worker \
                              --namespace sentinel-dev \
                              -o jsonpath='{.spec.template.spec.containers[0].image}'
                        )"

                        if [ -z "$WORKER_IMAGE" ]; then
                            echo "Unable to resolve the deployed worker image."
                            exit 1
                        fi

                        case "$WORKER_IMAGE" in
                            *@*)
                                echo "Digest-based worker images are not supported by this workflow yet."
                                exit 1
                                ;;
                            *:*)
                                ;;
                            *)
                                echo "Worker image does not contain an immutable tag."
                                exit 1
                                ;;
                        esac

                        WORKER_REPOSITORY="${WORKER_IMAGE%:*}"
                        WORKER_TAG="${WORKER_IMAGE##*:}"

                        case "$WORKER_TAG" in
                            ''|*[!0-9]*)
                                echo "Expected a Jenkins BUILD_NUMBER worker tag."
                                echo "Resolved image: $WORKER_IMAGE"
                                exit 1
                                ;;
                        esac

                        printf '%s\\n' \
                          "$WORKER_REPOSITORY" \
                          > .retraining-worker-repository

                        printf '%s\\n' \
                          "$WORKER_TAG" \
                          > .retraining-worker-tag

                        echo "Using deployed worker image: $WORKER_IMAGE"
                    '''
                }
            }
        }

        stage('Render Fetch Data Job') {
            steps {
                container('helm') {
                    sh '''
                        set -eu

                        WORKER_REPOSITORY="$(
                            cat .retraining-worker-repository
                        )"

                        WORKER_TAG="$(
                            cat .retraining-worker-tag
                        )"

                        # Preserve the standard config unless E2E mode was explicitly requested.
                        set -- -f charts/sentinel/values-dev.yaml
                        if [ "${E2E_FETCH_ONLY:-false}" = 'true' ]; then
                            set -- "$@" -f charts/sentinel/values-e2e.yaml
                        fi

                        helm template sentinel \
                          charts/sentinel \
                          --namespace sentinel-dev \
                          "$@" \
                          --set retraining.enabled=true \
                          --set retraining.validation.enabled=false \
                          --set-string retraining.runId="${BUILD_NUMBER}" \
                          --set-string worker.image.repository="${WORKER_REPOSITORY}" \
                          --set-string worker.image.tag="${WORKER_TAG}" \
                          --show-only templates/retraining-fetch-job.yaml \
                          > retraining-fetch-job.yaml

                        test -s retraining-fetch-job.yaml

                        grep -F \
                          "sentinel-retraining-fetch-${BUILD_NUMBER}" \
                          retraining-fetch-job.yaml \
                          > /dev/null

                        grep -F \
                          "${WORKER_REPOSITORY}:${WORKER_TAG}" \
                          retraining-fetch-job.yaml \
                          > /dev/null

                        echo "Retraining Fetch Data Job rendered successfully."
                    '''
                }
            }
        }

        stage('Verify E2E Fetch Isolation') {
            when {
                expression { params.E2E_FETCH_ONLY == true }
            }
            steps {
                container('python') {
                    sh '''
                        set -eu
                        uv run --frozen python - <<'PYCODE'
from pathlib import Path
import os
import yaml

manifests = [
    doc for doc in yaml.safe_load_all(
        Path('retraining-fetch-job.yaml').read_text()
    ) if doc
]
assert len(manifests) == 1, 'Expected exactly one E2E Fetch Job'
job = manifests[0]
assert job['kind'] == 'Job'
assert job['metadata']['name'] == f"sentinel-retraining-fetch-{os.environ['BUILD_NUMBER']}"
pod = job['spec']['template']['spec']
assert pod.get('automountServiceAccountToken') is False
assert len(pod['containers']) == 1
container = pod['containers'][0]
assert container['command'] == ['python', '-m', 'sentinel.retraining.fetch_data']
repository = Path('.retraining-worker-repository').read_text().strip()
tag = Path('.retraining-worker-tag').read_text().strip()
assert container['image'] == f'{repository}:{tag}', 'Worker image differs from deployed image'
assert 'envFrom' not in container
variables = {entry['name']: entry for entry in container['env']}
for key in ('POSTGRES_HOST', 'POSTGRES_PORT', 'POSTGRES_DB'):
    assert variables[key] == {
        'name': key,
        'valueFrom': {'configMapKeyRef': {
            'name': 'sentinel-retraining-e2e-db', 'key': key
        }}
    }, f'Incorrect E2E DB ConfigMap reference: {key}'
for key in ('POSTGRES_USER', 'POSTGRES_PASSWORD'):
    assert variables[key] == {
        'name': key,
        'valueFrom': {'secretKeyRef': {
            'name': 'sentinel-retraining-e2e-db-credentials', 'key': key
        }}
    }, f'Incorrect E2E DB Secret reference: {key}'
assert variables['RETRAINING_PIPELINE_NAME']['value'] == 'sentinel-retraining-e2e'
assert variables['RETRAINING_MIN_NEW_ROWS']['value'].isdigit()
print('PASS: Fetch Job is isolated to E2E database credentials and namespace')
PYCODE
                    '''
                }
            }
        }

        stage('Fetch Data') {
            steps {
                script {
                    def fetchStatus

                    container('kubectl') {
                        fetchStatus = sh(
                            script: '''
                                set -u

                                JOB_NAME="sentinel-retraining-fetch-${BUILD_NUMBER}"

                                if ! kubectl create \
                                  --namespace sentinel-dev \
                                  -f retraining-fetch-job.yaml
                                then
                                    echo "Failed to create retraining Fetch Data Job."
                                    exit 1
                                fi

                                if ! kubectl wait \
                                  --namespace sentinel-dev \
                                  --for=condition=complete \
                                  "job/${JOB_NAME}" \
                                  --timeout=5m
                                then
                                    echo "Retraining Fetch Data Job did not complete successfully."

                                    kubectl describe \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      || true

                                    kubectl logs \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      --all-containers=true \
                                      > retraining-fetch.log \
                                      2>&1 \
                                      || true

                                    cat retraining-fetch.log || true

                                    exit 1
                                fi

                                kubectl logs \
                                  --namespace sentinel-dev \
                                  "job/${JOB_NAME}" \
                                  --all-containers=true \
                                  > retraining-fetch.log \
                                  2>&1

                                cat retraining-fetch.log
                            ''',
                            returnStatus: true
                        )
                    }

                    archiveArtifacts(
                        artifacts: 'retraining-fetch.log',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )

                    if (fetchStatus != 0) {
                        error(
                            'Retraining Fetch Data Job failed.'
                        )
                    }
                }
            }
        }

        stage('Evaluate Data Gate') {
            steps {
                sh '''
                    set -eu

                    GATE_STATUS="$(
                        sed -n \
                          's/^retraining_gate=//p' \
                          retraining-fetch.log \
                        | tail -n 1
                    )"

                    RETRAINING_CUTOFF="$(
                        sed -n \
                          's/^retraining_cutoff=//p' \
                          retraining-fetch.log \
                        | tail -n 1
                    )"

                    NEW_ROWS="$(
                        sed -n \
                          's/^new_rows=//p' \
                          retraining-fetch.log \
                        | tail -n 1
                    )"

                    MINIMUM_NEW_ROWS="$(
                        sed -n \
                          's/^minimum_new_rows=//p' \
                          retraining-fetch.log \
                        | tail -n 1
                    )"

                    case "$GATE_STATUS" in
                        passed|blocked)
                            ;;
                        *)
                            echo "Invalid or missing retraining gate status."
                            exit 1
                            ;;
                    esac

                    if [ -z "$RETRAINING_CUTOFF" ]; then
                        echo "Invalid or missing retraining cutoff."
                        exit 1
                    fi

                    case "$NEW_ROWS" in
                        ''|*[!0-9]*)
                            echo "Invalid or missing new_rows value."
                            exit 1
                            ;;
                    esac

                    case "$MINIMUM_NEW_ROWS" in
                        ''|*[!0-9]*)
                            echo "Invalid or missing minimum_new_rows value."
                            exit 1
                            ;;
                    esac

                    printf '%s\\n' \
                      "$GATE_STATUS" \
                      > .retraining-gate-status

                    printf '%s\\n' \
                      "$RETRAINING_CUTOFF" \
                      > .retraining-cutoff

                    printf '%s\\n' \
                      "$NEW_ROWS" \
                      > .retraining-new-rows

                    printf '%s\\n' \
                      "$MINIMUM_NEW_ROWS" \
                      > .retraining-minimum-new-rows
                '''

                script {
                    def gateStatus = sh(
                        script: 'cat .retraining-gate-status',
                        returnStdout: true
                    ).trim()

                    def newRows = sh(
                        script: 'cat .retraining-new-rows',
                        returnStdout: true
                    ).trim()

                    def minimumNewRows = sh(
                        script: 'cat .retraining-minimum-new-rows',
                        returnStdout: true
                    ).trim()

                    echo(
                        "Retraining data gate: " +
                        "${newRows}/${minimumNewRows} new rows."
                    )

                    if (params.E2E_FETCH_ONLY == true) {
                        echo "E2E Fetch Data Gate: ${gateStatus} (${newRows}/${minimumNewRows} new rows)."
                        echo 'E2E fetch-only verification finished; no further stages will run.'
                        currentBuild.result = 'ABORTED'
                        error('E2E_FETCH_ONLY completed intentionally before training and promotion.')
                    }

                    if (gateStatus == 'blocked') {
                        currentBuild.result = 'ABORTED'

                        error(
                            'Retraining data gate blocked: ' +
                            "${newRows} new labeled rows are available, " +
                            "but ${minimumNewRows} are required."
                        )
                    }

                    if (gateStatus != 'passed') {
                        error(
                            "Unexpected retraining gate status: " +
                            gateStatus
                        )
                    }

                    echo(
                        'Retraining data gate passed.'
                    )
                }
            }
        }

        stage('Render Validation Job') {
            steps {
                container('helm') {
                    sh '''
                        set -eu

                        WORKER_TAG="$(
                            cat .retraining-worker-tag
                        )"

                        RETRAINING_CUTOFF="$(
                            cat .retraining-cutoff
                        )"

                        helm template sentinel \
                          charts/sentinel \
                          --namespace sentinel-dev \
                          -f charts/sentinel/values-dev.yaml \
                          --set retraining.enabled=true \
                          --set retraining.validation.enabled=true \
                          --set-string retraining.runId="${BUILD_NUMBER}" \
                          --set-string retraining.cutoff="${RETRAINING_CUTOFF}" \
                          --set-string retraining.validation.image.tag="${WORKER_TAG}" \
                          --show-only templates/retraining-validation-job.yaml \
                          > retraining-validation-job.yaml

                        test -s retraining-validation-job.yaml

                        grep -F \
                          "sentinel-retraining-validation-${BUILD_NUMBER}" \
                          retraining-validation-job.yaml \
                          > /dev/null

                        VALIDATOR_IMAGE="$(
                            sed -n \
                              's/^[[:space:]]*image: "\\(.*\\)"$/\\1/p' \
                              retraining-validation-job.yaml \
                            | head -n 1
                        )"

                        if [ -z "$VALIDATOR_IMAGE" ]; then
                            echo "Unable to resolve rendered validator image."
                            exit 1
                        fi

                        case "$VALIDATOR_IMAGE" in
                            *:"${WORKER_TAG}")
                                ;;
                            *)
                                echo "Validator image tag does not match deployed worker tag."
                                echo "Rendered validator image: $VALIDATOR_IMAGE"
                                echo "Expected immutable tag: $WORKER_TAG"
                                exit 1
                                ;;
                        esac

                        echo "Using validator image: $VALIDATOR_IMAGE"
                        echo "Retraining Validation Job rendered successfully."
                    '''
                }
            }
        }

        stage('Validate Training Data') {
            steps {
                script {
                    def validationStatus

                    container('kubectl') {
                        validationStatus = sh(
                            script: '''
                                set -u

                                JOB_NAME="sentinel-retraining-validation-${BUILD_NUMBER}"

                                if ! kubectl create \
                                  --namespace sentinel-dev \
                                  -f retraining-validation-job.yaml
                                then
                                    echo "Failed to create retraining Validation Job."
                                    exit 1
                                fi

                                if ! kubectl wait \
                                  --namespace sentinel-dev \
                                  --for=condition=complete \
                                  "job/${JOB_NAME}" \
                                  --timeout=5m
                                then
                                    echo "Retraining Validation Job did not complete successfully."

                                    kubectl describe \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      || true

                                    kubectl logs \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      --all-containers=true \
                                      > retraining-validation.log \
                                      2>&1 \
                                      || true

                                    cat retraining-validation.log || true

                                    exit 1
                                fi

                                kubectl logs \
                                  --namespace sentinel-dev \
                                  "job/${JOB_NAME}" \
                                  --all-containers=true \
                                  > retraining-validation.log \
                                  2>&1

                                cat retraining-validation.log

                                VALIDATION_STATUS="$(
                                    sed -n \
                                      's/^validation_status=//p' \
                                      retraining-validation.log \
                                    | tail -n 1
                                )"

                                if [ "$VALIDATION_STATUS" != "passed" ]; then
                                    echo "Training data validation did not report a passing status."
                                    echo "validation_status=${VALIDATION_STATUS}"
                                    exit 1
                                fi
                            ''',
                            returnStatus: true
                        )
                    }

                    archiveArtifacts(
                        artifacts: 'retraining-validation.log',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )

                    if (validationStatus != 0) {
                        error(
                            'Retraining training-data validation failed.'
                        )
                    }

                    echo(
                        'Retraining training-data validation passed.'
                    )
                }
            }
        }

        stage('Render Train Job') {
            steps {
                container('helm') {
                    sh '''
                        set -eu

                        WORKER_TAG="$(
                            cat .retraining-worker-tag
                        )"

                        RETRAINING_CUTOFF="$(
                            cat .retraining-cutoff
                        )"

                        helm template sentinel \
                          charts/sentinel \
                          --namespace sentinel-dev \
                          -f charts/sentinel/values-dev.yaml \
                          --set retraining.enabled=true \
                          --set retraining.validation.enabled=false \
                          --set retraining.train.enabled=true \
                          --set-string retraining.runId="${BUILD_NUMBER}" \
                          --set-string retraining.cutoff="${RETRAINING_CUTOFF}" \
                          --set-string retraining.train.image.tag="${WORKER_TAG}" \
                          --show-only templates/retraining-train-job.yaml \
                          > retraining-train-job.yaml

                        test -s retraining-train-job.yaml

                        grep -F \
                          "sentinel-retraining-train-${BUILD_NUMBER}" \
                          retraining-train-job.yaml \
                          > /dev/null

                        TRAIN_IMAGE="$(
                            sed -n \
                              's/^[[:space:]]*image: "\\(.*\\)"$/\\1/p' \
                              retraining-train-job.yaml \
                            | head -n 1
                        )"

                        if [ -z "$TRAIN_IMAGE" ]; then
                            echo "Unable to resolve rendered training image."
                            exit 1
                        fi

                        case "$TRAIN_IMAGE" in
                            *:"${WORKER_TAG}")
                                ;;
                            *)
                                echo "Training image tag does not match deployed worker tag."
                                echo "Rendered training image: $TRAIN_IMAGE"
                                echo "Expected immutable tag: $WORKER_TAG"
                                exit 1
                                ;;
                        esac

                        echo "Using retraining image: $TRAIN_IMAGE"
                        echo "Retraining Train Job rendered successfully."
                    '''
                }
            }
        }

        stage('Train') {
            steps {
                script {
                    def trainStatus

                    container('kubectl') {
                        trainStatus = sh(
                            script: '''
                                set -u

                                JOB_NAME="sentinel-retraining-train-${BUILD_NUMBER}"

                                if ! kubectl create \
                                  --namespace sentinel-dev \
                                  -f retraining-train-job.yaml
                                then
                                    echo "Failed to create retraining Train Job."
                                    exit 1
                                fi

                                if ! kubectl wait \
                                  --namespace sentinel-dev \
                                  --for=condition=complete \
                                  "job/${JOB_NAME}" \
                                  --timeout=30m
                                then
                                    echo "Retraining Train Job did not complete successfully."

                                    kubectl describe \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      || true

                                    kubectl logs \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      --all-containers=true \
                                      > retraining-train.log \
                                      2>&1 \
                                      || true

                                    cat retraining-train.log || true

                                    exit 1
                                fi

                                kubectl logs \
                                  --namespace sentinel-dev \
                                  "job/${JOB_NAME}" \
                                  --all-containers=true \
                                  > retraining-train.log \
                                  2>&1

                                cat retraining-train.log
                            ''',
                            returnStatus: true
                        )
                    }

                    archiveArtifacts(
                        artifacts: 'retraining-train.log',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )

                    if (trainStatus != 0) {
                        error(
                            'Retraining Train Job failed.'
                        )
                    }

                    echo(
                        'Retraining completed successfully. ' +
                        'Candidate model resolution will run next.'
                    )
                }
            }
        }

        stage('Resolve Candidate Model') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu

                        test -s retraining-train.log

                        CANDIDATE_MODEL_ID="$(
                            sed -n \
                                's/^candidate_model_id=//p' \
                                retraining-train.log \
                            | tail -n 1
                        )"

                        if [ -z "$CANDIDATE_MODEL_ID" ]; then
                            echo "Candidate ClearML model ID was not found."
                            exit 1
                        fi

                        case "$CANDIDATE_MODEL_ID" in
                            *[!0-9a-fA-F]*)
                                echo "Candidate model ID has an invalid format."
                                echo "Value: $CANDIDATE_MODEL_ID"
                                exit 1
                                ;;
                        esac

                        if [ "${#CANDIDATE_MODEL_ID}" -ne 32 ]; then
                            echo "Candidate model ID must contain 32 characters."
                            echo "Value: $CANDIDATE_MODEL_ID"
                            exit 1
                        fi

                        printf '%s\\n' \
                            "$CANDIDATE_MODEL_ID" \
                            > .candidate-model-id

                        echo "Candidate ClearML model ID resolved successfully."
                        echo "Candidate model ID: $CANDIDATE_MODEL_ID"
                    '''
                }

                archiveArtifacts(
                    artifacts: '.candidate-model-id',
                    fingerprint: true
                )
            }
        }

        stage('Render Gatekeeper Job') {
            steps {
                container('helm') {
                    sh '''
                        set -eu

                        test -s .current-model-id
                        test -s .candidate-model-id
                        test -s .retraining-worker-tag

                        CURRENT_MODEL_ID="$(
                            cat .current-model-id
                        )"

                        CANDIDATE_MODEL_ID="$(
                            cat .candidate-model-id
                        )"

                        WORKER_TAG="$(
                            cat .retraining-worker-tag
                        )"

                        if [ "$CURRENT_MODEL_ID" = "$CANDIDATE_MODEL_ID" ]; then
                            echo "Current and candidate model IDs are identical."
                            exit 1
                        fi

                        case "$WORKER_TAG" in
                            ''|*[!0-9]*)
                                echo "Invalid Gatekeeper image tag: $WORKER_TAG"
                                exit 1
                                ;;
                        esac

                        helm template sentinel \
                          charts/sentinel \
                          --namespace sentinel-dev \
                          -f charts/sentinel/values-dev.yaml \
                          --set retraining.enabled=true \
                          --set retraining.validation.enabled=false \
                          --set retraining.gatekeeper.enabled=true \
                          --set-string retraining.runId="${BUILD_NUMBER}" \
                          --set-string retraining.gatekeeper.currentModelReference="${CURRENT_MODEL_ID}" \
                          --set-string retraining.gatekeeper.candidateModelReference="${CANDIDATE_MODEL_ID}" \
                          --set-string retraining.gatekeeper.image.tag="${WORKER_TAG}" \
                          --show-only templates/retraining-gatekeeper-job.yaml \
                          > retraining-gatekeeper-job.yaml

                        test -s retraining-gatekeeper-job.yaml

                        grep -F \
                          "sentinel-retraining-gatekeeper-${BUILD_NUMBER}" \
                          retraining-gatekeeper-job.yaml \
                          > /dev/null

                        grep -F \
                          "sentinel.gatekeeper.compare" \
                          retraining-gatekeeper-job.yaml \
                          > /dev/null

                        grep -F \
                          "\"${CURRENT_MODEL_ID}\"" \
                          retraining-gatekeeper-job.yaml \
                          > /dev/null

                        grep -F \
                          "\"${CANDIDATE_MODEL_ID}\"" \
                          retraining-gatekeeper-job.yaml \
                          > /dev/null

                        GATEKEEPER_IMAGE="$(
                            sed -n \
                              's/^[[:space:]]*image: "\\(.*\\)"$/\\1/p' \
                              retraining-gatekeeper-job.yaml \
                            | head -n 1
                        )"

                        if [ -z "$GATEKEEPER_IMAGE" ]; then
                            echo "Unable to resolve rendered Gatekeeper image."
                            exit 1
                        fi

                        case "$GATEKEEPER_IMAGE" in
                            *:"${WORKER_TAG}")
                                ;;
                            *)
                                echo "Gatekeeper image tag does not match the immutable worker tag."
                                echo "Rendered Gatekeeper image: $GATEKEEPER_IMAGE"
                                echo "Expected immutable tag: $WORKER_TAG"
                                exit 1
                                ;;
                        esac

                        echo "Using Gatekeeper image: $GATEKEEPER_IMAGE"
                        echo "Gatekeeper Job rendered successfully."
                    '''
                }
            }
        }

        stage('Run Gatekeeper') {
            steps {
                script {
                    def gatekeeperStatus

                    container('kubectl') {
                        gatekeeperStatus = sh(
                            script: '''
                                set -u

                                JOB_NAME="sentinel-retraining-gatekeeper-${BUILD_NUMBER}"
                                JOB_RESULT=""

                                if ! kubectl create \
                                  --namespace sentinel-dev \
                                  -f retraining-gatekeeper-job.yaml
                                then
                                    echo "Failed to create Gatekeeper Job."
                                    exit 1
                                fi

                                for _ in $(seq 1 120)
                                do
                                    SUCCEEDED="$(
                                        kubectl get job \
                                          "$JOB_NAME" \
                                          --namespace sentinel-dev \
                                          -o jsonpath='{.status.succeeded}' \
                                          2>/dev/null \
                                          || true
                                    )"

                                    FAILED="$(
                                        kubectl get job \
                                          "$JOB_NAME" \
                                          --namespace sentinel-dev \
                                          -o jsonpath='{.status.failed}' \
                                          2>/dev/null \
                                          || true
                                    )"

                                    if [ "$SUCCEEDED" = "1" ]; then
                                        JOB_RESULT="passed"
                                        break
                                    fi

                                    case "$FAILED" in
                                        ''|0)
                                            ;;
                                        *)
                                            JOB_RESULT="failed"
                                            break
                                            ;;
                                    esac

                                    sleep 5
                                done

                                kubectl logs \
                                  --namespace sentinel-dev \
                                  "job/${JOB_NAME}" \
                                  --all-containers=true \
                                  > retraining-gatekeeper.log \
                                  2>&1 \
                                  || true

                                cat retraining-gatekeeper.log || true

                                if [ "$JOB_RESULT" != "passed" ]; then
                                    echo "Gatekeeper Job did not pass."

                                    kubectl describe \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      || true

                                    exit 1
                                fi

                                GATEKEEPER_STATUS="$(
                                    sed -n \
                                      's/^gatekeeper_status=//p' \
                                      retraining-gatekeeper.log \
                                    | tail -n 1
                                )"

                                if [ "$GATEKEEPER_STATUS" != "passed" ]; then
                                    echo "Invalid Gatekeeper result: $GATEKEEPER_STATUS"
                                    exit 1
                                fi

                                EXPECTED_CURRENT_MODEL_ID="$(
                                    cat .current-model-id
                                )"

                                EXPECTED_CANDIDATE_MODEL_ID="$(
                                    cat .candidate-model-id
                                )"

                                ACTUAL_CURRENT_MODEL_ID="$(
                                    sed -n \
                                      's/^current_model_reference=//p' \
                                      retraining-gatekeeper.log \
                                    | tail -n 1
                                )"

                                ACTUAL_CANDIDATE_MODEL_ID="$(
                                    sed -n \
                                      's/^candidate_model_reference=//p' \
                                      retraining-gatekeeper.log \
                                    | tail -n 1
                                )"

                                if [ "$ACTUAL_CURRENT_MODEL_ID" != "$EXPECTED_CURRENT_MODEL_ID" ]; then
                                    echo "Gatekeeper evaluated the wrong current model."
                                    exit 1
                                fi

                                if [ "$ACTUAL_CANDIDATE_MODEL_ID" != "$EXPECTED_CANDIDATE_MODEL_ID" ]; then
                                    echo "Gatekeeper evaluated the wrong candidate model."
                                    exit 1
                                fi

                                echo "Gatekeeper passed successfully."
                            ''',
                            returnStatus: true
                        )
                    }

                    archiveArtifacts(
                        artifacts: 'retraining-gatekeeper.log',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )

                    if (gatekeeperStatus != 0) {
                        error(
                            'Gatekeeper rejected the candidate model ' +
                            'or the evaluation failed.'
                        )
                    }

                    echo(
                        'Gatekeeper passed. ' +
                        'The candidate is eligible for Canary promotion. '
                        + 'Checkpoint will advance only after Canary and Git are verified.'
                    )
                }
            }
        }

        stage('Resolve Current Canary Reference') {
            steps {
                container('python') {
                    sh '''
                        set -eu

                        python scripts/update_canary_reference.py \
                          --file charts/sentinel/values-prod.yaml \
                          --read-current \
                          > .previous-canary-model-id

                        PREVIOUS_CANARY_ID="$(cat .previous-canary-model-id)"
                        CURRENT_MODEL_ID="$(cat .current-model-id)"
                        CANDIDATE_MODEL_ID="$(cat .candidate-model-id)"

                        if [ "$PREVIOUS_CANARY_ID" = "$CURRENT_MODEL_ID" ]; then
                            echo "Production and Canary models must differ."
                            exit 1
                        fi
                        if [ "$PREVIOUS_CANARY_ID" = "$CANDIDATE_MODEL_ID" ]; then
                            echo "Candidate is already the declared Canary model."
                            exit 1
                        fi

                        echo "Git Canary model reference: $PREVIOUS_CANARY_ID"
                    '''
                }
            }
        }

        stage('Preflight Git Synchronization') {
            steps {
                container('git') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'github-push-credentials',
                            usernameVariable: 'GIT_PUSH_USERNAME',
                            passwordVariable: 'GIT_PUSH_PASSWORD'
                        )
                    ]) {
                        sh '''
                        set +x
                        set -eu

                        # Jenkins Git plugin usually exposes GIT_BRANCH=origin/<branch>.
                        case "${GIT_BRANCH:-}" in
                            origin/*)
                                TARGET_BRANCH="${GIT_BRANCH#origin/}"
                                ;;
                            refs/remotes/origin/*)
                                TARGET_BRANCH="${GIT_BRANCH#refs/remotes/origin/}"
                                ;;
                            *)
                                echo "Cannot determine the trusted checkout branch."
                                echo "GIT_BRANCH=${GIT_BRANCH:-unset}"
                                exit 1
                                ;;
                        esac

                        git check-ref-format --branch "$TARGET_BRANCH" > /dev/null
                        printf '%s\n' "$TARGET_BRANCH" > .promotion-git-branch

                        git config --global --add safe.directory "$PWD"
                        REMOTE_URL="$(git remote get-url origin)"
                        case "$REMOTE_URL" in
                            https://github.com/*)
                                ;;
                            *)
                                echo "Only HTTPS GitHub origins are supported by this credential."
                                exit 1
                                ;;
                        esac

                        LOCAL_SHA="$(git rev-parse HEAD)"
                        REMOTE_SHA="$(
                            git ls-remote --exit-code origin \
                              "refs/heads/$TARGET_BRANCH" \
                            | awk '{print $1}'
                        )"
                        if [ -z "$REMOTE_SHA" ] || [ "$LOCAL_SHA" != "$REMOTE_SHA" ]; then
                            echo "Git remote advanced or checkout is stale; refusing promotion."
                            exit 1
                        fi

                        git diff --quiet -- charts/sentinel/values-prod.yaml
                        git diff --cached --quiet -- charts/sentinel/values-prod.yaml
                        # Verify push authorization without changing remote state.
                        ASKPASS_FILE="$(mktemp)"
                        trap 'rm -f "$ASKPASS_FILE"' EXIT HUP INT TERM
                        cat > "$ASKPASS_FILE" <<'ASKPASS'
#!/bin/sh
case "$1" in
    *sername*) printf '%s\n' "$GIT_PUSH_USERNAME" ;;
    *assword*) printf '%s\n' "$GIT_PUSH_PASSWORD" ;;
    *) exit 1 ;;
esac
ASKPASS
                        chmod 700 "$ASKPASS_FILE"
                        export GIT_TERMINAL_PROMPT=0
                        export GIT_ASKPASS="$ASKPASS_FILE"
                        git -c credential.helper= push --dry-run origin \
                          "HEAD:refs/heads/$TARGET_BRANCH"
                        echo "Git preflight passed for $TARGET_BRANCH at $REMOTE_SHA"
                    '''
                    }
                }
            }
        }

        stage('Render Canary Promotion Job') {
            steps {
                container('helm') {
                    sh '''
                        set -eu

                        CURRENT_MODEL_ID="$(cat .current-model-id)"
                        PREVIOUS_CANARY_ID="$(cat .previous-canary-model-id)"
                        CANDIDATE_MODEL_ID="$(cat .candidate-model-id)"
                        WORKER_TAG="$(cat .retraining-worker-tag)"

                        case "$WORKER_TAG" in
                            ''|*[!0-9]*)
                                echo "Invalid immutable training image tag."
                                exit 1
                                ;;
                        esac

                        helm template sentinel \
                          charts/sentinel \
                          --namespace sentinel-dev \
                          -f charts/sentinel/values-dev.yaml \
                          --set retraining.enabled=true \
                          --set retraining.validation.enabled=false \
                          --set retraining.canaryPromotion.enabled=true \
                          --set-string retraining.runId="${BUILD_NUMBER}" \
                          --set-string model.productionReference="${CURRENT_MODEL_ID}" \
                          --set-string retraining.canaryPromotion.candidateModelReference="${CANDIDATE_MODEL_ID}" \
                          --set-string retraining.canaryPromotion.expectedPreviousCanaryModelReference="${PREVIOUS_CANARY_ID}" \
                          --set-string retraining.canaryPromotion.image.tag="${WORKER_TAG}" \
                          --show-only templates/retraining-canary-promotion-job.yaml \
                          > retraining-canary-promotion-job.yaml

                        test -s retraining-canary-promotion-job.yaml
                        grep -F "sentinel-retraining-canary-promotion-${BUILD_NUMBER}" \
                          retraining-canary-promotion-job.yaml > /dev/null
                        grep -F "${CURRENT_MODEL_ID}" \
                          retraining-canary-promotion-job.yaml > /dev/null
                        grep -F "${PREVIOUS_CANARY_ID}" \
                          retraining-canary-promotion-job.yaml > /dev/null
                        grep -F "${CANDIDATE_MODEL_ID}" \
                          retraining-canary-promotion-job.yaml > /dev/null
                        CANARY_IMAGE="$(
                            sed -n \
                              's/^[[:space:]]*image: "\\(.*\\)"$/\\1/p' \
                              retraining-canary-promotion-job.yaml \
                            | head -n 1
                        )"
                        case "$CANARY_IMAGE" in
                            *:"${WORKER_TAG}")
                                ;;
                            *)
                                echo "Canary Job image is not the deployed immutable tag."
                                echo "Image: $CANARY_IMAGE"
                                exit 1
                                ;;
                        esac
                        echo "Canary Promotion Job rendered using $CANARY_IMAGE."
                    '''
                }
            }
        }

        stage('Run Canary Promotion') {
            steps {
                script {
                    def promotionStatus

                    container('kubectl') {
                        promotionStatus = sh(
                            script: '''
                                set -u

                                JOB_NAME="sentinel-retraining-canary-promotion-${BUILD_NUMBER}"

                                if ! kubectl create \
                                  --namespace sentinel-dev \
                                  -f retraining-canary-promotion-job.yaml
                                then
                                    echo "Failed to create Canary Promotion Job."
                                    exit 1
                                fi

                                if ! kubectl wait \
                                  --namespace sentinel-dev \
                                  --for=condition=complete \
                                  "job/${JOB_NAME}" \
                                  --timeout=10m
                                then
                                    echo "Canary Promotion Job failed or timed out."
                                    kubectl describe \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" || true
                                    kubectl logs \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      --all-containers=true \
                                      > retraining-canary-promotion.log 2>&1 || true
                                    cat retraining-canary-promotion.log || true
                                    echo "Inspect actual ClearML routing before any retry."
                                    exit 1
                                fi

                                kubectl logs \
                                  --namespace sentinel-dev \
                                  "job/${JOB_NAME}" \
                                  --all-containers=true \
                                  > retraining-canary-promotion.log 2>&1

                                cat retraining-canary-promotion.log
                                if ! grep -Fx \
                                  'canary_promotion_status=routing_verified' \
                                  retraining-canary-promotion.log > /dev/null
                                then
                                    echo "Promotion Job did not confirm routing verification."
                                    exit 1
                                fi
                            ''',
                            returnStatus: true
                        )
                    }

                    archiveArtifacts(
                        artifacts: 'retraining-canary-promotion.log',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )
                    if (promotionStatus != 0) {
                        error(
                            'Canary Promotion failed or could not be verified. ' +
                            'Checkpoint will not advance.'
                        )
                    }
                    echo 'Canary Promotion routing verified.'
                }
            }
        }

        stage('Update Canary Reference in Git') {
            steps {
                container('python') {
                    sh '''
                        set -eu
                        PREVIOUS_CANARY_ID="$(cat .previous-canary-model-id)"
                        CANDIDATE_MODEL_ID="$(cat .candidate-model-id)"

                        python scripts/update_canary_reference.py \
                          --file charts/sentinel/values-prod.yaml \
                          --expected-old-id "$PREVIOUS_CANARY_ID" \
                          --new-id "$CANDIDATE_MODEL_ID"
                    '''
                }

                script {
                    def gitStatus
                    container('git') {
                        withCredentials([
                            usernamePassword(
                                credentialsId: 'github-push-credentials',
                                usernameVariable: 'GIT_PUSH_USERNAME',
                                passwordVariable: 'GIT_PUSH_PASSWORD'
                            )
                        ]) {
                            gitStatus = sh(
                                script: '''
                                    set +x
                                    set -eu

                                    git config --global --add safe.directory "$PWD"
                                    TARGET_BRANCH="$(cat .promotion-git-branch)"
                                    git check-ref-format --branch "$TARGET_BRANCH" > /dev/null

                                    git add -- charts/sentinel/values-prod.yaml
                                    if ! git diff --cached --quiet -- charts/sentinel/values-prod.yaml
                                    then
                                        git -c user.name='Sentinel Retraining Bot' \
                                            -c user.email='sentinel-retraining-bot@users.noreply.github.com' \
                                            commit -m "chore: record Canary model $(cat .candidate-model-id)"
                                    fi

                                    ASKPASS_FILE="$(mktemp)"
                                    trap 'rm -f "$ASKPASS_FILE"' EXIT HUP INT TERM
                                    cat > "$ASKPASS_FILE" <<'ASKPASS'
#!/bin/sh
case "$1" in
    *sername*) printf '%s\n' "$GIT_PUSH_USERNAME" ;;
    *assword*) printf '%s\n' "$GIT_PUSH_PASSWORD" ;;
    *) exit 1 ;;
esac
ASKPASS
                                    chmod 700 "$ASKPASS_FILE"

                                    export GIT_TERMINAL_PROMPT=0
                                    export GIT_ASKPASS="$ASKPASS_FILE"
                                    git -c credential.helper= push origin \
                                      "HEAD:refs/heads/$TARGET_BRANCH"

                                    REMOTE_SHA="$(
                                        git ls-remote --exit-code origin \
                                          "refs/heads/$TARGET_BRANCH" | awk '{print $1}'
                                    )"
                                    test "$(git rev-parse HEAD)" = "$REMOTE_SHA"
                                    echo "Canary Git reference committed and pushed successfully."
                                ''',
                                returnStatus: true
                            )
                        }
                    }
                    if (gitStatus != 0) {
                        error(
                            'CRITICAL: Canary routing may have changed but Git ' +
                            'update failed. Check live Serving vs Git, ' +
                            'reconcile before retraining again. ' +
                            'Checkpoint was not updated.'
                        )
                    }
                }
            }
        }

        stage('Render Checkpoint Job') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu

                        test -s .retraining-worker-tag
                        test -s .retraining-cutoff

                        WORKER_TAG="$(
                            cat .retraining-worker-tag
                        )"

                        RETRAINING_CUTOFF="$(
                            cat .retraining-cutoff
                        )"

                        case "$WORKER_TAG" in
                            ''|*[!0-9]*)
                                echo "Invalid retraining worker tag: $WORKER_TAG"
                                exit 1
                                ;;
                        esac

                        if [ -z "$RETRAINING_CUTOFF" ]; then
                            echo "Retraining cutoff is missing."
                            exit 1
                        fi

                        helm template sentinel \
                          charts/sentinel \
                          --namespace sentinel-dev \
                          -f charts/sentinel/values-dev.yaml \
                          --set retraining.enabled=true \
                          --set retraining.checkpoint.enabled=true \
                          --set retraining.validation.enabled=false \
                          --set-string retraining.runId="${BUILD_NUMBER}" \
                          --set-string retraining.cutoff="${RETRAINING_CUTOFF}" \
                          --set-string worker.image.tag="${WORKER_TAG}" \
                          --show-only templates/retraining-checkpoint-job.yaml \
                          > retraining-checkpoint-job.yaml

                        test -s retraining-checkpoint-job.yaml

                        grep -F \
                          "sentinel-retraining-checkpoint-${BUILD_NUMBER}" \
                          retraining-checkpoint-job.yaml \
                          > /dev/null

                        CHECKPOINT_IMAGE="$(
                            sed -n \
                              's/^[[:space:]]*image: "\\(.*\\)"$/\\1/p' \
                              retraining-checkpoint-job.yaml \
                            | head -n 1
                        )"

                        if [ -z "$CHECKPOINT_IMAGE" ]; then
                            echo "Unable to resolve rendered checkpoint image."
                            exit 1
                        fi

                        case "$CHECKPOINT_IMAGE" in
                            *:"${WORKER_TAG}")
                                ;;
                            *)
                                echo "Checkpoint image tag does not match deployed worker tag."
                                echo "Rendered checkpoint image: $CHECKPOINT_IMAGE"
                                echo "Expected immutable tag: $WORKER_TAG"
                                exit 1
                                ;;
                        esac

                        grep -F \
                          "value: \\"${RETRAINING_CUTOFF}\\"" \
                          retraining-checkpoint-job.yaml \
                          > /dev/null

                        echo "Using checkpoint image: $CHECKPOINT_IMAGE"
                        echo "Checkpoint Job rendered successfully."
                    '''
                }
            }
        }

        stage('Update Checkpoint') {
            steps {
                script {
                    def checkpointStatus

                    container('kubectl') {
                        checkpointStatus = sh(
                            script: '''
                                set -u

                                JOB_NAME="sentinel-retraining-checkpoint-${BUILD_NUMBER}"

                                if ! kubectl create \
                                  --namespace sentinel-dev \
                                  -f retraining-checkpoint-job.yaml
                                then
                                    echo "Failed to create retraining Checkpoint Job."
                                    exit 1
                                fi

                                if ! kubectl wait \
                                  --namespace sentinel-dev \
                                  --for=condition=complete \
                                  "job/${JOB_NAME}" \
                                  --timeout=2m
                                then
                                    echo "Retraining Checkpoint Job did not complete successfully."

                                    kubectl describe \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      || true

                                    kubectl logs \
                                      --namespace sentinel-dev \
                                      "job/${JOB_NAME}" \
                                      --all-containers=true \
                                      > retraining-checkpoint.log \
                                      2>&1 \
                                      || true

                                    cat retraining-checkpoint.log || true

                                    exit 1
                                fi

                                kubectl logs \
                                  --namespace sentinel-dev \
                                  "job/${JOB_NAME}" \
                                  --all-containers=true \
                                  > retraining-checkpoint.log \
                                  2>&1

                                cat retraining-checkpoint.log

                                CHECKPOINT_STATUS="$(
                                    sed -n \
                                      's/^checkpoint_status=//p' \
                                      retraining-checkpoint.log \
                                    | tail -n 1
                                )"

                                case "$CHECKPOINT_STATUS" in
                                    advanced|unchanged)
                                        ;;
                                    *)
                                        echo "Invalid checkpoint status: $CHECKPOINT_STATUS"
                                        exit 1
                                        ;;
                                esac

                                EXPECTED_CUTOFF="$(
                                    cat .retraining-cutoff
                                )"

                                ACTUAL_CUTOFF="$(
                                    sed -n \
                                      's/^last_successful_cutoff=//p' \
                                      retraining-checkpoint.log \
                                    | tail -n 1
                                )"

                                if [ "$ACTUAL_CUTOFF" != "$EXPECTED_CUTOFF" ]; then
                                    echo "Stored checkpoint does not match retraining cutoff."
                                    echo "Expected: $EXPECTED_CUTOFF"
                                    echo "Actual:   $ACTUAL_CUTOFF"
                                    exit 1
                                fi

                                echo "Retraining checkpoint verified successfully."
                            ''',
                            returnStatus: true
                        )
                    }

                    archiveArtifacts(
                        artifacts: 'retraining-checkpoint.log',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )

                    if (checkpointStatus != 0) {
                        error(
                            'Retraining Checkpoint Job failed.'
                        )
                    }

                    echo(
                        'Retraining pipeline completed successfully ' +
                        'and the successful cutoff was persisted.'
                    )
                }
            }
        }
    }

    post {
        always {
            container('kubectl') {
                sh '''
                    if [ -f .e2e-seed-job-created ]; then
                        kubectl delete job sentinel-e2e-data-gate-seed \
                          --namespace sentinel-dev \
                          --ignore-not-found=true \
                          --wait=false || true
                    fi

                    kubectl delete job \
                      "sentinel-retraining-fetch-${BUILD_NUMBER}" \
                      --namespace sentinel-dev \
                      --ignore-not-found=true \
                      --wait=false \
                      || true

                    kubectl delete job \
                      "sentinel-retraining-validation-${BUILD_NUMBER}" \
                      --namespace sentinel-dev \
                      --ignore-not-found=true \
                      --wait=false \
                      || true

                    kubectl delete job \
                      "sentinel-retraining-train-${BUILD_NUMBER}" \
                      --namespace sentinel-dev \
                      --ignore-not-found=true \
                      --wait=false \
                      || true

                    kubectl delete job \
                      "sentinel-retraining-gatekeeper-${BUILD_NUMBER}" \
                      --namespace sentinel-dev \
                      --ignore-not-found=true \
                      --wait=false \
                      || true

                    kubectl delete job \
                      "sentinel-retraining-canary-promotion-${BUILD_NUMBER}" \
                      --namespace sentinel-dev \
                      --ignore-not-found=true \
                      --wait=false \
                      || true

                    kubectl delete job \
                      "sentinel-retraining-checkpoint-${BUILD_NUMBER}" \
                      --namespace sentinel-dev \
                      --ignore-not-found=true \
                      --wait=false \
                      || true
                '''
            }

            sh '''
                rm -f retraining-fetch-job.yaml
                rm -f retraining-fetch.log
                rm -f retraining-validation-job.yaml
                rm -f retraining-validation.log
                rm -f retraining-train-job.yaml
                rm -f retraining-train.log
                rm -f retraining-gatekeeper-job.yaml
                rm -f retraining-gatekeeper.log
                rm -f retraining-canary-promotion-job.yaml
                rm -f retraining-canary-promotion.log
                rm -f .previous-canary-model-id
                rm -f .promotion-git-branch
                rm -f retraining-checkpoint-job.yaml
                rm -f retraining-checkpoint.log
                rm -f .current-model-id
                rm -f .candidate-model-id
                rm -f .retraining-worker-repository
                rm -f .retraining-worker-tag
                rm -f .retraining-gate-status
                rm -f .retraining-cutoff
                rm -f .retraining-new-rows
                rm -f .retraining-minimum-new-rows
                rm -f retraining-e2e-data-seed-job.yaml
                rm -f retraining-e2e-data-seed.log
                rm -f .e2e-seed-job-created
            '''
        }
    }
}
