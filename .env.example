# Copy to .env ONLY in a clean deployment directory, never overwrite existing .env.
# Replace all CHANGE_ME values. Keep .env out of source control.
RABBITMQ_USERNAME=sentinel
RABBITMQ_PASSWORD=CHANGE_ME_LONG_RANDOM_RABBITMQ_PASSWORD
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_GRAFANA_PASSWORD
LOG_LEVEL=INFO
AUTO_INFERENCE_ENABLED=true
FRONTEND_PORT=5173
SENTINEL_API_PORT=8000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
JAEGER_PORT=16686
RABBITMQ_UI_PORT=15672
RABBITMQ_PORT_HOST=5672
# Unavailable until ClearML Serving is configured; inference predictions will fail.
CLEARML_CANARY_URL=http://clearml-serving-inference:8080/serve/sentinel-mnist-canary
# ClearML credentials are optional until the Producer is explicitly started.
# CLEARML_API_HOST=http://clearml-apiserver:8008
# CLEARML_WEB_HOST=http://clearml-webserver:80
# CLEARML_FILES_HOST=http://clearml-fileserver:8081
# CLEARML_API_ACCESS_KEY=
# CLEARML_API_SECRET_KEY=

# Full-stack-only variables. Replace ALL CHANGE_ME values before runtime.
CLEARML_SERVER_IMAGE=clearml/server:latest
CLEARML_WEB_PORT_HOST=8080
CLEARML_API_PORT_HOST=8008
CLEARML_FILES_PORT_HOST=8081
CLEARML_FILES_PUBLIC_URL=http://localhost:8081
CLEARML_API_ACCESS_KEY=CHANGE_ME_CLEARML_ACCESS_KEY
CLEARML_API_SECRET_KEY=CHANGE_ME_CLEARML_SECRET_KEY
CLEARML_SERVING_TASK_ID=CHANGE_ME_EXISTING_CLEARML_SERVING_TASK_ID
CLEARML_TRITON_IMAGE=allegroai/clearml-serving-triton:1.3.1
CLEARML_INFERENCE_IMAGE=allegroai/clearml-serving-inference:1.3.1
CLEARML_INFERENCE_PORT_HOST=8085
JENKINS_PORT_HOST=8082
JENKINS_AGENT_PORT_HOST=50001

